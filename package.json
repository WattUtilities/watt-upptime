{
  "name": "watt-upptime",
  "version": "1.0.0",
  "private": true,
  "description": "Local development tooling for the Watt Utilities Upptime uptime monitor and status page",
  "scripts": {
    "upptime": "./scripts/upptime.sh",
    "uptime": "./scripts/upptime.sh update",
    "response-time": "./scripts/upptime.sh response-time",
